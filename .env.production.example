# Configuration de production pour VPS
# Copiez ce fichier vers .env et configurez les valeurs

# Django Security
SECRET_KEY=votre-cle-secrete-tres-longue-et-aleatoire-generee-par-django
DEBUG=False
ALLOWED_HOSTS=votre-domaine.com,www.votre-domaine.com,votre-ip-vps

# Database PostgreSQL
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://gestion_stock_user:votre_mot_de_passe@localhost:5432/gestion_stock_db

# CORS / CSRF Configuration
# IMPORTANT : mettez le vrai domaine de production ici (avec https://), sinon les
# requêtes depuis d'autres postes/navigateurs peuvent être rejetées (CORS/CSRF) dès
# que CORS_ALLOW_ALL_ORIGINS=False et DEBUG=False.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://votre-domaine.com,https://www.votre-domaine.com
CSRF_TRUSTED_ORIGINS=https://votre-domaine.com,https://www.votre-domaine.com

# Fond de carte GPS (optionnel). Par défaut : tuiles Esri World Street Map, sans clé.
# Pour un fournisseur avec clé API (recommandé si forte utilisation), par exemple MapTiler :
# MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=VOTRE_CLE
# MAP_TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
# MAP_TILE_SUBDOMAINS=abc
# MAP_TILE_MAX_ZOOM=19
# MAP_TILE_MAX_NATIVE_ZOOM=18

# Email Configuration (optionnel)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.votre-serveur.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=votre-email@domaine.com
# EMAIL_HOST_PASSWORD=votre-mot-de-passe-email

# Sentry (monitoring des erreurs - optionnel)
# SENTRY_DSN=https://votre-cle@sentry.io/votre-projet

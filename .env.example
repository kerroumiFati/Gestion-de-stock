# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=votre-domaine.com,www.votre-domaine.com,votre-ip-vps

# Database (pour VPS)
DATABASE_URL=postgresql://gestion_stock_user:votre-mot-de-passe@localhost:5432/gestion_stock_db

# CORS
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://votre-domaine.com,https://www.votre-domaine.com

# Security (Production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# IMPORTANT: Dans GitHub Secrets, assurez-vous que chaque variable est sur une ligne séparée
# Exemple correct:
# SECRET_KEY=abc123
# DEBUG=False
# ALLOWED_HOSTS=example.com
#
# Exemple INCORRECT (ne pas faire):
# SECRET_KEY=abc123DEBUG=False